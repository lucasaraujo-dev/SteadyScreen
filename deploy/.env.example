# Copy to .env on the VPS and fill in. Never commit the real .env.

# Domain pointing to this VPS (A record to its IP). HTTPS comes from certbot.
DOMAIN=steadyscreen.example.com

# Database (accounts, chats). Use a long random password: openssl rand -hex 32
POSTGRES_DB=steadyscreen
POSTGRES_USER=steadyscreen
POSTGRES_PASSWORD=

# Local ports nginx forwards to (only reachable from the VPS itself).
WEB_PORT=3210
SERVER_PORT=8210

# Max people watching one room.
MAX_VIEWERS=5

# TURN relay (the turn service): without it the video often never connects
# between different networks. Secret: openssl rand -hex 32
TURN_SECRET=
# The VPS's public IPv4.
PUBLIC_IP=
# Leave empty to use turn:DOMAIN:3478 (udp and tcp).
TURN_URLS=
